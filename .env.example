# Copy to .env.local (gitignored) and fill in real values.
# See the setup comment at the top of app/api/waitlist/route.ts for how
# to obtain each of these.

# Google Sheets — where every waitlist submission is logged as a row.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Gmail SMTP — sends a notification email for every submission.
EMAIL_USER=
EMAIL_APP_PASSWORD=
NOTIFY_EMAIL_TO=
